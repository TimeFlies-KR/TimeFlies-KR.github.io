---
// 글 모음 섹션(블로그·게임)의 개별 글 페이지.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { enabledSections, url, formatDate } from '../../site.config';
import { getEntries } from '../../lib/entries';

export async function getStaticPaths() {
  const paths = [];
  for (const section of enabledSections) {
    if (section.kind !== 'collection') continue;
    for (const entry of await getEntries(section.collection)) {
      paths.push({ params: { section: section.id, slug: entry.id }, props: { section, entry } });
    }
  }
  return paths;
}

const { section, entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
---

<Base title={data.title} description={data.description} current={section.id}>
  <a class="back" href={url(`${section.id}/`)}>← {section.label}</a>
  <article class="prose">
    <h1>{data.title}</h1>
    <p class="meta">
      {formatDate(data.date)}
      {'tags' in data && data.tags.map((t: string) => <span class="tag">{t}</span>)}
    </p>
    {
      'status' in data && (
        <dl class="facts">
          <dt>장르</dt>
          <dd>{data.genre}</dd>
          <dt>상태</dt>
          <dd>{data.status}</dd>
          {data.platforms.length > 0 && (
            <>
              <dt>플랫폼</dt>
              <dd>{data.platforms.join(', ')}</dd>
            </>
          )}
        </dl>
      )
    }
    <Content />
  </article>
</Base>
